# Optional: HTTP Basic Auth for the API (leave blank to disable)
ADMIN_USERNAME=
ADMIN_PASSWORD=

# CORS origins (comma-separated). Use your domain in production.
CORS_ORIGINS=*

# Public base URL of this server (https). Required for image posts to Slack.
# Slack fetches images from this URL, so it must be reachable from the internet.
# Example: https://your-domain.com
# Leave empty if you don't use the image posting feature.
PUBLIC_BASE_URL=

# GitHub repository (used by docker-compose to resolve image name)
# e.g. your-github-username/my_slack_news
GITHUB_REPOSITORY=

# Docker image tag (set by CI/CD)
IMAGE_TAG=latest
