# Gemini API key (https://aistudio.google.com/ から取得)
GEMINI_API_KEY=your_gemini_api_key_here

# Slack Incoming Webhook URL
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz

# 任意: config.json のRSSフィードを上書き（カンマ区切り）
# RSS_FEED_URLS=https://feeds.feedburner.com/oreilly/radar/atom,https://techcrunch.com/feed/

# 任意: config.json のキーワードを上書き（カンマ区切り）
# KEYWORDS=AI,機械学習,LLM,生成AI

# 任意
PORT=8080
GEMINI_MODEL=gemini-1.5-flash
MAX_ARTICLES=20
